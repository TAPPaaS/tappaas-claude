#!/usr/bin/env python3
"""commit-msg hook for the TAPPaaS Codeberg repos (installed by tappaas-claude/link.sh).

Everyone:        no Claude co-author/attribution lines (Codeberg hygiene).
Claude sessions  (CLAUDECODE=1): the CLAUDE.md message rules —
                 `type(scope): summary` subject of at most 72 characters, a blank
                 line before any body, and at most 3 body lines (issue-closing
                 lines such as `close #123` do not count).
Merge and revert commits generated by git or the forge are left alone.
"""
import os
import re
import sys

MAX_SUBJECT = 72
MAX_BODY = 3
SUBJECT = re.compile(
    r"^(feat|fix|docs|refactor|test|chore|perf|build|ci|style|revert)(\([a-z0-9._/-]+\))?!?: \S")
ISSUE_LINE = re.compile(r"^(close[sd]?|fix(e[sd])?|resolve[sd]?|refs?)\s+#\d+", re.IGNORECASE)
ATTRIBUTION = re.compile(r"co-authored-by:.*(claude|anthropic)|generated with \[?claude", re.IGNORECASE)


def main(path):
    with open(path, encoding="utf-8") as fh:
        lines = [l.rstrip("\n") for l in fh if not l.startswith("#")]
    while lines and not lines[-1].strip():
        lines.pop()
    text = "\n".join(lines)
    errors = []

    if ATTRIBUTION.search(text):
        errors.append("remove the Claude co-author / 'Generated with Claude' line")

    if os.environ.get("CLAUDECODE") == "1" and lines and not re.match(r"^(Merge|Revert) ", lines[0]):
        subject = lines[0]
        if not SUBJECT.match(subject):
            errors.append("subject must be 'type(scope): summary' (feat, fix, docs, refactor, test, chore, ...)")
        if len(subject) > MAX_SUBJECT:
            errors.append("subject is %d characters; the limit is %d" % (len(subject), MAX_SUBJECT))
        if len(lines) > 1 and lines[1].strip():
            errors.append("leave a blank line between the subject and the body")
        body = [l for l in lines[2:] if l.strip() and not ISSUE_LINE.match(l.strip())]
        if len(body) > MAX_BODY:
            errors.append("body is %d lines; the limit is %d (details belong in the issue)" % (len(body), MAX_BODY))

    if errors:
        sys.stderr.write("commit-msg: commit rejected\n" + "".join("  - %s\n" % e for e in errors))
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1]))
